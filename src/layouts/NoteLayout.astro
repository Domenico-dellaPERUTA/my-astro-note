---
import { renderMarkdown } from "../lib/markdown";
import Diagramma from "../components/Diagramma.svelte";
import AudioAvatarBridge from "../components/AudioAvatarBridge.svelte";
import { getEntry } from "astro:content";
import { getRawSiteConfig } from "../lib/siteConfig";

interface Props {
    title: string;
    content: string;
    type: "note" | "quiz" | "slide" | "diagram";
    userRole: "guest" | "admin";
    targetLang?: string; // Nuova prop per la lingua target (es: "en", "es", "fr", ecc.)
}

const { title, content, type, userRole, targetLang = "original" } = Astro.props;
const html = type !== "diagram" ? await renderMarkdown(content) : "";
const id = Astro.url.searchParams.get("id");

// Recupera la lingua di default per passarla al bridge e usarla nel client leggendo direttamente il file
const config = await getRawSiteConfig();
const defaultLang = config.defaultLang || "it";
---

<div class="annotazione">
    <span class="pin">📍 </span>
    <div class="header-view">
        <h2>{title}</h2>
        <div class="actions">
            {
                type !== "slide" && (
                    <AudioAvatarBridge
                        title={title}
                        content={content}
                        lang={targetLang}
                        defaultLang={defaultLang}
                        client:load
                    />
                )
            }
            {
                userRole === "admin" && (
                    <a
                        href={`?id=${id}&edit=true`}
                        class="btn-edit"
                        title="Modifica nota"
                    >
                        📝
                    </a>
                )
            }
        </div>
    </div>

    <div class="content-body">
        {
            type === "diagram" ? (
                <div class="diagram-workspace">
                    <Diagramma content={content} client:load />
                </div>
            ) : (
                <div
                    id="testo-renderizzato"
                    class="testo"
                    data-content={content}
                    data-target-lang={targetLang}
                    data-default-lang={defaultLang}
                >
                    <Fragment set:html={html} />
                </div>
            )
        }
    </div>
</div>

<script>
    import { mount } from "svelte";
    import Quiz from "../components/Quiz.svelte";
    import Slide from "../components/Slide.svelte";

    let originalHTML = "";
    let currentLang = "original";
    let isTranslating = false;
    let translationCache: Record<string, string> = {};

    import { actions } from "astro:actions";

    async function translateText(
        text: string,
        targetLang: string,
    ): Promise<string> {
        try {
            console.log(
                `[translateText] Translating to ${targetLang}:`,
                text.substring(0, 50),
            );
            const result = await actions.proxyTranslate({
                text,
                targetLang,
            });
            if (result.data && result.data.success) {
                return result.data.translatedText || text;
            }
            console.error(
                `[translateText] ProxyTranslate error response:`,
                result.data,
            );
            throw new Error(result.data?.error || "Translation failed");
        } catch (error) {
            console.error("Translation error:", error);
            return text;
        }
    }

    async function translateHTML(
        html: string,
        targetLang: string,
    ): Promise<string> {
        const parser = new DOMParser();
        const doc = parser.parseFromString(html, "text/html");

        // Trova tutti i nodi di testo
        const walker = document.createTreeWalker(
            doc.body,
            NodeFilter.SHOW_TEXT,
            {
                acceptNode: function (node) {
                    // Salta nodi vuoti o solo spazi
                    if (!node.textContent?.trim()) {
                        return NodeFilter.FILTER_REJECT;
                    }
                    // Salta nodi dentro <code> o <pre>
                    let parent = node.parentElement;
                    while (parent) {
                        if (
                            parent.tagName === "CODE" ||
                            parent.tagName === "PRE" ||
                            parent.classList.contains("quiz-placeholder") ||
                            parent.classList.contains("slide-placeholder")
                        ) {
                            return NodeFilter.FILTER_REJECT;
                        }
                        parent = parent.parentElement;
                    }
                    return NodeFilter.FILTER_ACCEPT;
                },
            },
        );

        const textNodes: Node[] = [];
        let node;
        while ((node = walker.nextNode())) {
            textNodes.push(node);
        }

        console.log(
            `[translateHTML] Found ${textNodes.length} translatable text nodes.`,
        );

        // Traduci ogni nodo di testo
        for (const [index, textNode] of textNodes.entries()) {
            const originalText = textNode.textContent || "";
            if (originalText.trim()) {
                console.log(
                    `[translateHTML] Translating node ${index + 1}/${textNodes.length} (length: ${originalText.length})`,
                );
                const translatedText = await translateText(
                    originalText,
                    targetLang,
                );
                textNode.textContent = translatedText;
            }
        }

        console.log(`[translateHTML] Done translating all nodes.`);
        return doc.body.innerHTML;
    }

    async function applyTranslation(targetLang: string) {
        console.log(
            `[NoteLayout applyTranslation] Requesting translation to: ${targetLang}, currentLang: ${currentLang}`,
        );
        const container = document.getElementById("testo-renderizzato");
        if (!container) return;
        if (isTranslating) return;

        // Se la lingua è già quella corrente, non fare nulla
        if (currentLang === targetLang) return;

        // Se torna all'originale o alla lingua di default
        const defaultLang = container.getAttribute("data-default-lang") || "it";
        if (targetLang === "original" || targetLang === defaultLang) {
            console.log(
                `[NoteLayout applyTranslation] targetLang ("${targetLang}") is default ("${defaultLang}") or "original". Reverting to originalHTML.`,
            );
            container.innerHTML = originalHTML;
            currentLang = "original";
            await mountInteractiveComponents();
            return;
        }

        isTranslating = true;

        // Mostra loader (clessidra animata per comprensione universale)
        const loader = document.createElement("div");
        loader.className = "translation-loader";
        loader.innerHTML = '<span class="hourglass">⏳</span>';
        container.insertBefore(loader, container.firstChild);

        try {
            // Salva l'HTML originale se non è già salvato
            if (!originalHTML) {
                originalHTML = container.innerHTML;
            }

            // Usa la cache se disponibile
            let translatedHTML: string;
            if (translationCache[targetLang]) {
                translatedHTML = translationCache[targetLang];
            } else {
                translatedHTML = await translateHTML(originalHTML, targetLang);
                translationCache[targetLang] = translatedHTML;
            }

            container.innerHTML = translatedHTML;
            currentLang = targetLang;
            await mountInteractiveComponents();
        } catch (error) {
            console.error("Error during translation:", error);
            // Ripristina l'originale in caso di errore
            container.innerHTML = originalHTML;
            currentLang = "original";
        } finally {
            loader?.remove();
            isTranslating = false;
        }
    }

    async function mountInteractiveComponents() {
        const container = document.getElementById("testo-renderizzato");
        if (!container) return;

        // Mount Quizzes
        container.querySelectorAll(".quiz-placeholder").forEach((element) => {
            const ph = element as HTMLElement;
            if (ph.dataset.mounted) return;
            const dataStr = ph.getAttribute("data-quiz");
            if (dataStr) {
                try {
                    const decoded = decodeURIComponent(atob(dataStr));
                    const quizData = JSON.parse(decoded);
                    mount(Quiz, { target: ph, props: { quiz: quizData } });
                    ph.dataset.mounted = "true";
                    ph.style.minHeight = "0";
                    ph.style.border = "none";
                    ph.style.backgroundColor = "transparent";
                } catch (e) {
                    console.error("Errore mounting quiz:", e);
                }
            }
        });

        // Mount Slides
        const slidesPlaceholders =
            container.querySelectorAll(".slide-placeholder");
        if (slidesPlaceholders.length > 0) {
            const { createHighlighter } = await import("shiki");
            const hl = await createHighlighter({
                themes: ["github-light"],
                langs: [
                    "javascript",
                    "typescript",
                    "html",
                    "css",
                    "xml",
                    "json",
                    "bash",
                    "python",
                ],
            });

            slidesPlaceholders.forEach((element) => {
                const ph = element as HTMLElement;
                if (ph.dataset.mounted) return;
                const dataStr = ph.getAttribute("data-slide");
                if (dataStr) {
                    try {
                        const decoded = decodeURIComponent(atob(dataStr));
                        const slideData = JSON.parse(decoded);
                        const processedSlides = slideData.slides.map(
                            (slide: any) => {
                                if (slide.type === "code") {
                                    const renderedCode = hl.codeToHtml(
                                        slide.content,
                                        {
                                            lang: slide.lang || "text",
                                            theme: "github-light",
                                        },
                                    );
                                    return { ...slide, content: renderedCode };
                                }
                                return slide;
                            },
                        );
                        mount(Slide, {
                            target: ph,
                            props: { slides: processedSlides },
                        });
                        ph.dataset.mounted = "true";
                        ph.style.minHeight = "0";
                        ph.style.border = "none";
                        ph.style.backgroundColor = "transparent";
                    } catch (e) {
                        console.error("Errore mounting slide:", e);
                    }
                }
            });
        }
    }

    // Inizializzazione
    async function init() {
        const container = document.getElementById("testo-renderizzato");
        if (!container) return;

        // Salva l'HTML originale
        originalHTML = container.innerHTML;

        // Monta i componenti interattivi
        await mountInteractiveComponents();

        // Applica la traduzione iniziale se specificata e diversa dalla default
        const targetLang = container.getAttribute("data-target-lang");
        const defaultLang = container.getAttribute("data-default-lang") || "it";

        console.log(`[NoteLayout INIT] Starting initialization.`);
        console.log(
            `[NoteLayout INIT] container data-target-lang: "${targetLang}"`,
        );
        console.log(
            `[NoteLayout INIT] container data-default-lang: "${defaultLang}"`,
        );
        console.log(
            `[NoteLayout INIT] currentLang (js variable): "${currentLang}"`,
        );

        if (
            targetLang &&
            targetLang !== "original" &&
            targetLang !== defaultLang
        ) {
            console.log(
                `[NoteLayout INIT] Condition met for initial translation to: ${targetLang}`,
            );
            await applyTranslation(targetLang);
        } else {
            console.log(`[NoteLayout INIT] Skipping initial translation.`);
        }

        // Osserva i cambiamenti dell'attributo data-target-lang
        const observer = new MutationObserver(async (mutations) => {
            for (const mutation of mutations) {
                if (
                    mutation.type === "attributes" &&
                    mutation.attributeName === "data-target-lang"
                ) {
                    const newLang = container.getAttribute("data-target-lang");
                    console.log(
                        `[NoteLayout OBSERVER] data-target-lang changed to: "${newLang}"`,
                    );
                    if (newLang) {
                        await applyTranslation(newLang);
                    }
                }
            }
        });

        observer.observe(container, {
            attributes: true,
            attributeFilter: ["data-target-lang"],
        });
    }

    // Esegui l'inizializzazione quando il DOM è pronto
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", init);
    } else {
        init();
    }
</script>

<style>
    .pin {
        position: absolute;
        top: -1rem;
        left: 0.5rem;
        font-size: 3rem;
        overflow: visible;
        z-index: 10;
    }
    .annotazione {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 20px;
        font-family: var(--font-main);
        background-color: #fffcf0;
        padding: 40px;
        box-shadow:
            1px 1px 3px rgba(0, 0, 0, 0.1),
            5px 5px 0px rgba(0, 0, 0, 0.05);
        margin: 20px;
        max-width: 1200px;
        width: calc(100% - 40px);
        min-height: 80vh;
        height: auto;
        flex-shrink: 0;
    }
    .header-view {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        border-bottom: 2px solid var(--text-ink);
        padding-bottom: 10px;
    }
    .header-view h2 {
        border-bottom: none;
        padding-bottom: 0;
        margin: 0;
        text-transform: uppercase;
        letter-spacing: 1px;
        flex: 1;
        font-size: 2rem;
        font-weight: bold;
        color: var(--text-ink);
    }
    .actions {
        display: flex;
        gap: 15px;
        align-items: center;
    }
    .btn-edit {
        background: none;
        border: none;
        font-size: 1.5rem;
        cursor: pointer;
        padding: 5px;
        border-radius: 50%;
        transition: transform 0.2s;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .btn-edit:hover {
        transform: scale(1.2);
        background-color: rgba(0, 0, 0, 0.05);
    }
    .testo {
        width: 100%;
        padding: 15px;
        border: none;
        font-family: var(--font-main);
        font-size: 1.1rem;
        line-height: 1.6;
        color: var(--text-ink);
    }
    .testo :global(.quiz-placeholder),
    .testo :global(.slide-placeholder) {
        min-height: 200px;
        background-color: rgba(0, 0, 0, 0.02);
        border: 1px dashed #ccc;
        margin: 20px 0;
        display: block;
    }
    .testo :global(img) {
        max-width: 100%;
        height: auto;
        display: block;
        margin: 1rem 0;
        box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.1);
        border: 1px solid #ddd;
    }
    .testo :global(em),
    .testo :global(i) {
        font-family:
            "Brush Script MT", "Brush Script Std", "Lucida Calligraphy", cursive;
        font-size: 1.7rem;
        color: #4e73ab;
        font-style: normal;
    }
    .diagram-workspace {
        flex-grow: 1;
        background: white;
        border: 1px solid #ccc;
        padding: 10px;
        overflow: hidden;
    }

    .translation-loader {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 20px;
        margin-bottom: 15px;
        background: rgba(255, 255, 255, 0.5);
        border-radius: 10px;
    }

    .hourglass {
        font-size: 3rem;
        animation: flip 2s infinite linear;
        display: inline-block;
    }

    @keyframes flip {
        0% {
            transform: rotate(0deg);
        }
        40% {
            transform: rotate(180deg);
        }
        50% {
            transform: rotate(180deg);
        }
        90% {
            transform: rotate(360deg);
        }
        100% {
            transform: rotate(360deg);
        }
    }
</style>
