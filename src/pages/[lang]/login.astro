---
import Layout from "../../layouts/Layout.astro";
import LoginForm from "../../components/LoginForm.svelte";
import { useTranslations } from "../../i18n/utils";
import { ui } from "../../i18n/ui";

const { lang } = Astro.params;
const currentLang = (lang as keyof typeof ui) || "it";
const i18n = useTranslations(currentLang);

export function getStaticPaths() {
    return [
        { params: { lang: "en" } }, 
        { params: { lang: "it" } }, 
        { params: { lang: "es" } }, 
        { params: { lang: "fr" } }, 
        { params: { lang: "de" } }, 
        { params: { lang: "zh" } }, 
        { params: { lang: "ja" } }, 
        { params: { lang: "ar" } }, 
        { params: { lang: "ru" } }
    ];
}
---

<Layout lang={currentLang}>
    <div class="login-container">
        <div class="login-card">
            <h2>{i18n("login.title")}</h2>

            <LoginForm
                passwordLabel={i18n("login.password")}
                tokenLabel={i18n("login.token")}
                userLabel={i18n("login.username")}
                backLink={i18n("login.backLink")}
                startMassage={i18n("login.message.startingLogin")}
                successMessage={i18n("login.message.success")}
                errorMessage={i18n("login.message.error")}
                errorConnectionMessage={i18n("login.message.errorConnection")}
                currentLang={currentLang}
                client:load
            />
        </div>
    </div>
</Layout>

<style>
    .login-container {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        background-color: var(--bg-paper);
        background-image: radial-gradient(#d0c9b6 2px, transparent 2px);
        background-size: 30px 30px;
    }

    .login-card {
        background-color: #fffcf0;
        padding: 40px;
        border-radius: 2px;
        box-shadow: 5px 5px 15px rgba(0, 0, 0, 0.2);
        width: 100%;
        max-width: 400px;
        border: 1px solid #ccc;
        font-family: var(--font-main);
    }

    h2 {
        text-align: center;
        margin-top: 0;
        border-bottom: 2px solid var(--text-ink);
        padding-bottom: 10px;
        margin-bottom: 30px;
        text-transform: uppercase;
        letter-spacing: 2px;
    }

    .actions {
        display: flex;
        flex-direction: column;
        gap: 15px;
        margin-top: 30px;
        text-align: center;
    }
</style>
